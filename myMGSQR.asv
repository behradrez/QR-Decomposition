function [Q,R] = myMGSQR(A)
    [n,m] = size(A);

    Q = zeros(n,m);
    R = zeros(m,m);

    for curr_col = 1:1:m
        A_col = A(:,curr_col);
        r_diag = norm(A_col);
        Q_col = A_col / r_diag;

        % For all future A columns, remove this projection
        for next_col = curr_col+1:1:m
            r_entry = transpose(Q_col) * A(:, next_col);
            R(curr_col, next_col) = r_entry;
            A(:, next_col) = A(:, next_col) - r_entry * Q_col;
        end

        Q(:, curr_col) = Q_col;
        R(curr_col, curr_col) = r_diag;
    end
end