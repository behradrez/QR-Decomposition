function testmyGSQR()
    n = randi(10);
    n = 10
    m = n + randi(5);
    m = 5
    range = randi(50);
    A = randn([n,m]) * range;
    
    [Q,R] = myGSQR(A);
    
    recomposed = Q*R;
    is_proper_decompose = isequal(recomposed,A);
    if ~is_proper_decompose
        for i = 1:1:n
            for j = 1:1:m
                entry_equal = (Q*R)(i,j) == A(i,j);
                if ~entry_equal
                    fprintf("Entry at %d %d not equal: Q: %f A: %f", i,j,Q(i,j), A(i,j));
                end
            end
        end
        disp("Q*R:");
        disp(Q*R);
        disp("A");
        disp(A);
        disp("Q*R not equal A");
        assert(is_proper_decompose);
    end

    is_orthonormal = isequal(transpose(Q)*Q,eye([n,m]));
    if ~is_orthonormal
        disp("Q not orthonormal: ");
        disp(transpose(Q)*Q);
        assert(is_orthonormal);
    end

    disp("Tests passed");
    

end